page {
  height: 100%;
  background: #FFF6EF;
  color: #35261B;
  font-family: -apple-system, "PingFang SC", "Hiragino Sans GB", sans-serif;
  font-size: 28rpx;
}

/* ---------- 通用按钮 ---------- */
.btn {
  margin: 0;
  padding: 0;
  background: none;
  border-radius: 0;
  line-height: 1.4;
  font-size: 28rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: auto;
  box-sizing: border-box;
}
.btn::after { border: none; }

.btn.ghost {
  background: #FFFFFF;
  color: #35261B;
  font-weight: 600;
  font-size: 26rpx;
  padding: 10rpx 24rpx;
  border-radius: 18rpx;
  box-shadow: 0 8rpx 24rpx rgba(176, 120, 80, .12);
}

.btn.primary {
  background: linear-gradient(135deg, #FF8A5C, #FF5A36);
  color: #ffffff;
  font-weight: 800;
  box-shadow: 0 10rpx 26rpx rgba(255, 90, 54, .30);
}

.btn.secondary {
  background: #ffffff;
  color: #E04E2C;
  font-weight: 700;
  border: 3rpx solid #FFD9CC;
}

.btn.danger {
  background: #E5484D;
  color: #ffffff;
  font-weight: 700;
}

/* ---------- 弹窗 ---------- */
.modal-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(53, 38, 27, .45);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}
.modal-box {
  width: 100%;
  max-width: 620rpx;
  background: #ffffff;
  border-radius: 36rpx;
  padding: 40rpx 36rpx 32rpx;
}
.modal-title { font-size: 34rpx; font-weight: 800; margin-bottom: 24rpx; }
.modal-input {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 40rpx;
  font-weight: 700;
  text-align: center;
  color: #35261B;
  padding: 0 20rpx;
  border-radius: 22rpx;
  border: 3rpx solid #F1E3D7;
  background: #FFFBF7;
  box-sizing: border-box;
}
.modal-text { font-size: 28rpx; color: #6B5445; line-height: 1.5; display: block; }
.modal-actions { display: flex; gap: 20rpx; margin-top: 32rpx; }
.modal-btn {
  flex: 1;
  padding: 20rpx 0;
  font-size: 30rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
