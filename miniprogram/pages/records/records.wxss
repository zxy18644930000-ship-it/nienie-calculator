.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

.tools {
  flex: none;
  display: flex;
  gap: 16rpx;
  padding: 20rpx 24rpx 8rpx;
}

.list { flex: 1; min-height: 0; }

.empty {
  text-align: center;
  color: #A6907F;
  font-size: 28rpx;
  padding: 140rpx 0;
}

.record {
  position: relative;
  margin: 16rpx 24rpx 0;
  padding: 22rpx 26rpx 22rpx;
  background: #ffffff;
  border-radius: 26rpx;
  box-shadow: 0 8rpx 24rpx rgba(176, 120, 80, .10);
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.r-id { font-size: 24rpx; font-weight: 700; color: #6B5445; }
.r-top { display: flex; justify-content: space-between; align-items: center; gap: 16rpx; }
.r-no { font-size: 28rpx; font-weight: 700; color: #35261B; }
.r-no.muted { color: #A6907F; font-weight: 600; }
.r-time { font-size: 24rpx; color: #A6907F; }
.r-items { font-size: 27rpx; color: #6B5445; line-height: 1.45; }
.r-disc { font-size: 24rpx; font-weight: 600; color: #B4402A; line-height: 1.45; }
.r-total { font-size: 38rpx; font-weight: 800; color: #E04E2C; }
.r-del {
  position: absolute;
  right: 20rpx;
  bottom: 20rpx;
  font-size: 26rpx;
  color: #A6907F;
  padding: 8rpx 14rpx;
}
.list-bottom { height: calc(30rpx + env(safe-area-inset-bottom)); }
