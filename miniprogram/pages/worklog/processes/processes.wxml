<view class="wl-page">

  <view class="tabs">
    <view class="tab on">工序</view>
    <view class="tab" bindtap="goTab" data-t="prod">品类管理</view>
  </view>

  <view wx:if="{{err}}" class="wl-card">
    <view class="wl-empty">{{err}}</view>
    <view class="btn primary wl-btn" bindtap="load">重试</view>
  </view>

  <block wx:elif="{{ready}}">
    <view class="wl-card">
      <view class="wl-h">
        <text>工序列表</text>
        <view class="wl-chip" bindtap="onAdd">＋ 新增工序</view>
      </view>
      <view wx:if="{{!list.length}}" class="wl-empty">还没有工序，点上面「新增工序」添加</view>
      <view class="wl-row" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}" bindtap="onEditRow">
        <view class="wl-grow">
          <view class="wl-name">{{item.name}}</view>
          <view class="wl-meta">¥{{item.price_text}}/件</view>
        </view>
        <view class="wl-chip {{item.active ? '' : 'gray'}}" data-id="{{item.id}}" catchtap="toggleActive">
          {{item.active ? '启用中' : '已停用'}}
        </view>
      </view>
    </view>
    <view class="wl-sub" style="text-align:center">点一行可以改名或改单价；点右边的「启用中/已停用」可以开关</view>
  </block>
</view>

<view wx:if="{{showEdit}}" class="modal-mask" bindtap="closeEdit">
  <view class="modal-box" catchtap="noop">
    <view class="modal-title">{{editId ? '编辑工序' : '新增工序'}}</view>
    <view class="wl-sub" style="margin-bottom:14rpx">工序名</view>
    <input class="wl-input" value="{{editName}}" placeholder="如 内包装 / 外包装 / 画画" maxlength="20"
           bindinput="onNameInput" always-embed="{{true}}" adjust-position="{{false}}" />
    <view class="wl-sub" style="margin:22rpx 0 14rpx">单价（元/件）</view>
    <input class="wl-input" type="digit" value="{{editPrice}}" placeholder="如 0.15"
           bindinput="onPriceInput" confirm-type="done" bindconfirm="save" always-embed="{{true}}" adjust-position="{{false}}" />
    <view class="modal-actions">
      <view class="btn secondary modal-btn" bindtap="closeEdit">取消</view>
      <view class="btn primary modal-btn" bindtap="save">保存</view>
    </view>
  </view>
</view>
