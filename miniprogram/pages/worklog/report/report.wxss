@import "../common.wxss";

.photo-empty {
  border: 4rpx dashed #FFC9B8;
  border-radius: 24rpx;
  background: #FFFBF7;
  height: 380rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
}
.photo-plus { font-size: 96rpx; color: #FF8A5C; line-height: 1; font-weight: 300; }
.photo-tip { font-size: 26rpx; color: #A6907F; }

.photo-img {
  width: 100%;
  height: 440rpx;
  border-radius: 20rpx;
  background: #F6EAE0;
}
.photo-actions { display: flex; gap: 20rpx; margin-top: 18rpx; }
.photo-actions .btn { flex: 1; padding: 18rpx 0; border-radius: 18rpx; font-size: 28rpx; }

.qty-row {
  display: flex;
  align-items: center;
  gap: 22rpx;
  justify-content: center;
  padding: 8rpx 0 14rpx;
}
.qty-btn {
  width: 110rpx;
  height: 110rpx;
  border-radius: 26rpx;
  background: #FFF1EA;
  color: #E04E2C;
  font-size: 56rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}
.qty-input {
  flex: 1;
  max-width: 280rpx;
  height: 110rpx;
  line-height: 110rpx;
  text-align: center;
  font-size: 56rpx;
  font-weight: 900;
  color: #35261B;
  background: #FFFBF7;
  border: 3rpx solid #F1E3D7;
  border-radius: 26rpx;
  box-sizing: border-box;
}

.photo-status { margin-top: 14rpx; text-align: center; }
.ps-text { font-size: 24rpx; color: #A6907F; }
.ps-text.warn { color: #D9363E; font-weight: 700; }

.retry-btn {
  display: inline-flex;
  align-items: center;
  margin-left: 16rpx;
  padding: 8rpx 26rpx;
  border-radius: 999rpx;
  border: 3rpx solid #E04E2C;
  color: #E04E2C;
  font-size: 24rpx;
  font-weight: 700;
  vertical-align: middle;
}

.picker-box {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 32rpx;
  color: #35261B;
  padding: 0 22rpx;
  border-radius: 20rpx;
  border: 3rpx solid #F1E3D7;
  background: #FFFBF7;
  box-sizing: border-box;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.picker-box.muted { color: #A6907F; }

.sug-chip {
  margin: 6rpx 0 16rpx;
  padding: 20rpx 0;
  border-radius: 22rpx;
  background: #EDF7EE;
  border: 3rpx dashed #9BCB9E;
  color: #2E7D32;
  font-size: 30rpx;
  font-weight: 800;
  text-align: center;
}
